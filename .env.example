# OpenRouter API Key (required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub Personal Access Token (optional, increases rate limits)
GITHUB_TOKEN=your_github_token_here

# OpenRouter model (default: moonshotai/kimi-k2-0905)
OPENROUTER_MODEL=moonshotai/kimi-k2-0905

# Base URL for OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Max repair iterations for the repair loop
MAX_REPAIR_ITERATIONS=3

# Top-k files to retrieve
RETRIEVAL_TOP_K=10

# Temp directory for cloned repositories
REPO_TEMP_DIR=./tmp/repos

# Output directory for generated PRs
OUTPUT_DIR=./outputs

# Logging level
LOG_LEVEL=INFO
